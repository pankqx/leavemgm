# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000
NODE_ENV=development

# Local MongoDB, or your MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/leavemgm?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/leavemgm

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed browser origins (the Angular app URL)
CORS_ORIGINS=http://localhost:4200
